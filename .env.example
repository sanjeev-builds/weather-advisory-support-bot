# Copy this file to .env and fill in your API key
# Get a free Groq API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: Use NVIDIA NIM instead (free key at https://build.nvidia.com) --
# tried if GROQ_API_KEY is unset. More free-tier headroom than Groq, slower per request.
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: Use Google Gemini instead (get key at https://aistudio.google.com/apikey)
# GOOGLE_API_KEY=your_google_api_key_here
